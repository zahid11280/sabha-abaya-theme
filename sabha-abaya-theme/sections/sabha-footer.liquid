{% style %}
#shopify-section-{{ section.id }}{--fb-bg:{{ section.settings.bg }};--fb-text:{{ section.settings.text }};--fb-link:{{ section.settings.link }};--fb-muted:{{ section.settings.muted }};--fb-gold:{{ section.settings.gold }};--fb-pt:{{ section.settings.pad_top }}px;--fb-pb:{{ section.settings.pad_bottom }}px}
{% endstyle %}

<div class="sb-footer" role="contentinfo">
  <div>
    <div class="sb-brand">
      <span>{{ section.settings.brand_letter }}</span><b>{{ section.settings.brand_name }}</b><small>{{ section.settings.brand_sub }}</small>
    </div>
    <p>{{ section.settings.tagline }}</p>
    <div class="sb-social">
      {%- for block in section.blocks -%}
        {%- if block.type == 'social' -%}<a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'menu' -%}
      <div {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading }}</h4>
        {%- for link in block.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

  <div>
    <h4>{{ section.settings.nl_heading }}</h4>
    <p>{{ section.settings.nl_text }}</p>
    {%- form 'customer', id: 'sbNewsletter', class: 'sb-newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" required placeholder="{{ section.settings.nl_placeholder | escape }}" aria-label="Email address">
      <button type="submit">{{ section.settings.nl_button }}</button>
    {%- endform -%}
    {%- if form.posted_successfully? -%}<small class="sb-ok">Thank you for joining {{ section.settings.brand_name | capitalize }}</small>{%- endif -%}
    <small>{{ section.settings.nl_note }}</small>
  </div>

  <div class="sb-legal">
    <span>{{ section.settings.copyright }}</span>
    {%- for link in section.settings.legal_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
  </div>
</div>

{% stylesheet %}
.sb-footer{background:var(--fb-bg,#191816);color:var(--fb-text,#eee);padding:var(--fb-pt,70px) 6vw var(--fb-pb,25px);display:grid;grid-template-columns:1.4fr .7fr .9fr 1.4fr;gap:50px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:normal}
.sb-footer *{box-sizing:border-box}
.sb-footer a{display:block;color:var(--fb-link,#aaa)!important;text-decoration:none!important;margin:12px 0;font-size:.85rem;font-family:Arial,Helvetica,sans-serif}
.sb-footer p,.sb-footer small{color:var(--fb-muted,#999)!important;line-height:1.6;font-family:Arial,Helvetica,sans-serif}
.sb-footer p{font-size:16px;margin:16px 0}
.sb-footer small{font-size:13.33px}
.sb-footer h4{font:400 1.1rem Georgia,serif!important;margin:0 0 21px!important;color:var(--fb-text,#eee)!important;letter-spacing:normal!important;text-transform:none!important}
.sb-brand{display:grid;grid-template-columns:38px auto;grid-template-rows:22px 12px;width:max-content;color:#fff}
.sb-brand span{grid-row:1/3;border:1px solid var(--fb-gold,#b99159);border-radius:50%;width:32px;height:32px;text-align:center;line-height:30px;font-family:Georgia,serif;font-size:1.2rem;color:var(--fb-gold,#b99159)}
.sb-brand b{font-family:Georgia,serif;letter-spacing:.22em;font-size:1rem;color:#fff}
.sb-footer .sb-brand small{letter-spacing:.32em;font-size:.52rem;color:#766f68!important;line-height:normal}
.sb-social{color:var(--fb-text,#eee)}
.sb-footer .sb-social a{display:inline;margin:0 14px 0 0;font-size:16px;color:var(--fb-text,#eee)!important}
.sb-newsletter{display:flex;margin:0}
.sb-footer .sb-newsletter input[type=email]{min-width:0;flex:1;background:transparent;border:0;border-bottom:1px solid #555;border-radius:0;color:#fff;padding:12px;font:inherit;outline:0;box-shadow:none;height:auto}
.sb-footer .sb-newsletter button{border:0;border-bottom:1px solid #555;border-radius:0;background:transparent;color:#fff;font:inherit;padding:1px 6px;cursor:pointer;height:auto;min-height:0;text-transform:none;letter-spacing:normal}
.sb-footer .sb-ok{display:block;margin-top:10px;color:var(--fb-text,#eee)!important}
.sb-legal{grid-column:1/-1;border-top:1px solid #333;padding-top:20px;display:flex;gap:22px;align-items:center;color:var(--fb-text,#eee)}
.sb-footer .sb-legal a{display:inline;margin:0}
@media(max-width:900px){.sb-footer{grid-template-columns:1fr 1fr}.sb-legal{flex-wrap:wrap}}
@media(max-width:560px){.sb-footer{grid-template-columns:1fr;padding:55px 25px var(--fb-pb,25px)}.sb-legal{display:block}.sb-footer .sb-legal a{display:inline-block;margin-right:14px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Sabha Footer",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "brand_letter", "label": "Logo letter", "default": "S" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "SABHA" },
    { "type": "text", "id": "brand_sub", "label": "Sub name", "default": "ABAYA CO." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Modern modest wear, designed with quiet confidence." },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "nl_heading", "label": "Heading", "default": "Stay in the know" },
    { "type": "text", "id": "nl_text", "label": "Text", "default": "New collections, private offers and styling notes." },
    { "type": "text", "id": "nl_placeholder", "label": "Placeholder", "default": "Email address" },
    { "type": "text", "id": "nl_button", "label": "Button", "default": "Join" },
    { "type": "text", "id": "nl_note", "label": "Small note", "default": "By subscribing, you agree to receive marketing emails. Unsubscribe anytime." },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2026 Sabha Abaya Co." },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu (Privacy, Terms, Contact)" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#191816" },
    { "type": "color", "id": "text", "label": "Text", "default": "#eeeeee" },
    { "type": "color", "id": "link", "label": "Links", "default": "#aaaaaa" },
    { "type": "color", "id": "muted", "label": "Muted text", "default": "#999999" },
    { "type": "color", "id": "gold", "label": "Logo accent", "default": "#b99159" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 70 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 25 }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Instagram" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sabha Footer",
      "blocks": [
        { "type": "social", "settings": { "label": "Instagram" } },
        { "type": "social", "settings": { "label": "Pinterest" } },
        { "type": "social", "settings": { "label": "TikTok" } },
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Help" } }
      ]
    }
  ]
}
{% endschema %}
