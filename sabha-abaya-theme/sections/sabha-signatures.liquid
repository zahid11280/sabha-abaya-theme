{%- assign col = section.settings.collection -%}
{%- assign ptm = section.settings.pad_top | times: 0.65 | round -%}
{%- assign pbm = section.settings.pad_bottom | times: 0.65 | round -%}
{% style %}
#shopify-section-{{ section.id }}{--sb-ink:{{ section.settings.ink }};--sb-muted:{{ section.settings.muted }};--sb-gold:{{ section.settings.gold }};--sb-cream:{{ section.settings.btn_bg }};--sb-bg:{{ section.settings.bg }};--sb-pt:{{ section.settings.pad_top }}px;--sb-pb:{{ section.settings.pad_bottom }}px;--sb-cols:{{ section.settings.columns }}}
@media(max-width:560px){#shopify-section-{{ section.id }}{--sb-pt:{{ ptm }}px;--sb-pb:{{ pbm }}px}}
{% endstyle %}

<section class="sb-section"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="sb-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="sb-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="sb-textlink" href="{{ section.settings.link_url | default: col.url | default: '/collections/all' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  <div class="sb-grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          {%- render 'sabha-card', product: block.settings.product, badge: block.settings.badge, block_attrs: block.shopify_attributes, show_badge: section.settings.show_badge, show_swatches: section.settings.show_swatches, show_quick: section.settings.show_quick -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for product in col.products limit: section.settings.limit -%}
        {%- render 'sabha-card', product: product, badge: '', block_attrs: '', show_badge: section.settings.show_badge, show_swatches: section.settings.show_swatches, show_quick: section.settings.show_quick -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
<div class="sb-toast" id="sbToast"></div>

{% stylesheet %}
.sb-section{--ink:var(--sb-ink,#1d1a18);--cream:var(--sb-cream,#f6f1ea);--line:#ded6cd;--muted:var(--sb-muted,#766f68);--gold:var(--sb-gold,#b99159);padding:var(--sb-pt,85px) 5vw var(--sb-pb,85px);font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--sb-bg,#fff);font-size:16px;line-height:normal}
.sb-section *{box-sizing:border-box}
.sb-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:35px}
.sb-section .sb-eyebrow{text-transform:uppercase;letter-spacing:.22em;font-size:.72rem;color:var(--gold);margin-bottom:25px}
.sb-section .sb-head h2{font:400 clamp(2.2rem,4vw,4rem) Georgia,serif;margin:0;color:var(--ink);text-transform:none;letter-spacing:normal}
.sb-section .sb-textlink{color:var(--ink);text-underline-offset:5px}
.sb-grid{display:grid;grid-template-columns:repeat(var(--sb-cols,4),1fr);gap:22px}
.sb-card{position:relative;display:flex;flex-direction:column;min-width:0}
.sb-card>a{order:1;display:block}
.sb-img{aspect-ratio:3/4;background:linear-gradient(145deg,#b7a58f,#272421);position:relative;overflow:hidden}
.sb-img img{width:100%;height:100%;object-fit:cover;display:block}
.sb-section .sb-pill{position:absolute;top:13px;left:13px;background:#fff;padding:7px 10px;font-size:.65rem;font-family:Arial,Helvetica,sans-serif;line-height:normal;letter-spacing:.08em;text-transform:uppercase;color:var(--ink)!important}
.sb-section .sb-card h3{order:2;font:400 1.05rem Georgia,serif;margin:14px 0 6px;line-height:1.35;min-height:2.7em;color:var(--ink);text-transform:none;letter-spacing:normal}
.sb-meta{order:3;display:flex;justify-content:space-between;gap:8px;color:var(--muted);font-size:.83rem}
.sb-swatches{order:4;display:flex;gap:5px;margin-top:10px}
.sb-section .sb-swatches button{width:18px;height:18px;min-width:0;min-height:0;border-radius:50%;border:1px solid #b8b0a8;background:var(--sw);padding:0;box-shadow:0 0 0 2px #fff;transition:transform .15s,outline-color .15s;cursor:pointer}
.sb-section .sb-swatches button:hover{transform:scale(1.12)}
.sb-section .sb-swatches button.active{outline:2px solid var(--ink);outline-offset:2px}
.sb-section .sb-quick{display:block;order:5;width:100%;margin:13px 0 0;padding:11px;background:var(--cream);color:var(--ink);border:1px solid var(--line);border-radius:0;font:400 16px Arial,Helvetica,sans-serif;text-transform:none;letter-spacing:normal;line-height:normal;height:auto;min-height:0;cursor:pointer;opacity:1;visibility:visible;transition:none}
.sb-section .sb-quick:hover{background:var(--ink);color:#fff;border-color:var(--line)}
.sb-toast{position:fixed;left:50%;bottom:30px;transform:translate(-50%,20px);background:#1d1a18;color:#fff;padding:13px 20px;opacity:0;z-index:9999;transition:.2s;pointer-events:none;font-family:Arial,Helvetica,sans-serif}
.sb-toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:900px){.sb-grid{grid-template-columns:repeat(2,1fr);gap:12px}}
@media(max-width:560px){
.sb-section{padding-left:18px;padding-right:18px}
.sb-head{align-items:start}
.sb-grid{grid-template-columns:1fr 1fr;column-gap:14px;row-gap:34px}
.sb-img{aspect-ratio:2.7/4}
.sb-section .sb-card h3{font-size:1rem;margin-top:11px}
.sb-meta{flex-direction:column;gap:3px;font-size:.9rem}
.sb-section .sb-quick{font-size:.76rem;margin-top:10px;padding:10px}
}
/* theme-override lock */
.sb-section a{color:inherit;text-decoration:none}
.sb-section .sb-textlink{color:var(--ink)!important;text-decoration:underline!important;font-size:16px;font-family:Arial,Helvetica,sans-serif}
.sb-section .sb-pill{color:var(--ink)!important;font-weight:400!important}
.sb-section .sb-eyebrow{color:var(--gold)!important;font-weight:400!important;font-family:Arial,Helvetica,sans-serif!important}
.sb-section .sb-head h2{color:var(--ink)!important;font:400 clamp(2.2rem,4vw,4rem) Georgia,serif!important;margin:0!important;letter-spacing:normal!important;text-transform:none!important}
.sb-section .sb-card h3{color:var(--ink)!important;font:400 1.05rem/1.35 Georgia,serif!important;margin:14px 0 6px!important;letter-spacing:normal!important;text-transform:none!important}
.sb-section .sb-meta,.sb-section .sb-meta span{font-family:Arial,Helvetica,sans-serif!important;color:var(--muted)!important;font-weight:400!important}
@media(max-width:560px){.sb-section .sb-card h3{font-size:1rem!important;margin-top:11px!important}}
{% endstylesheet %}

{% javascript %}
(function(){
  if(window.__sbInit)return;window.__sbInit=1;
  function toast(m){var t=document.getElementById('sbToast');if(!t)return;t.textContent=m;t.classList.add('show');setTimeout(function(){t.classList.remove('show')},2400)}
  document.addEventListener('click',function(e){
    var s=e.target.closest('.sb-swatches button');
    if(s){
      var card=s.closest('.sb-card');
      card.querySelectorAll('.sb-swatches button').forEach(function(x){x.classList.remove('active')});
      s.classList.add('active');
      card.dataset.color=s.title;
      if(s.dataset.img){var im=card.querySelector('.sb-img img');if(im){im.removeAttribute('srcset');im.src=s.dataset.img}}
      return;
    }
    var q=e.target.closest('.sb-quick');
    if(!q)return;
    var c=q.closest('.sb-card'),vs=JSON.parse(c.dataset.variants),ci=+c.dataset.ci,col=c.dataset.color;
    var v=vs.find(function(x){return x.o[ci]===col&&x.a})||vs.find(function(x){return x.a});
    if(!v){toast('Sold out');return}
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:v.id,quantity:1})})
      .then(function(r){if(!r.ok)throw 0;return r.json()})
      .then(function(){
        toast('Added to your bag');
        ['cart:refresh','cart:updated','theme:cart:reload'].forEach(function(n){document.dispatchEvent(new CustomEvent(n,{bubbles:true}))});
      })
      .catch(function(){toast('Could not add to bag')});
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Sabha Signatures",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sabha signatures" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "text", "id": "anchor", "label": "Anchor ID (optional)" },
    { "type": "header", "content": "Products" },
    { "type": "paragraph", "content": "Add 'Product' blocks to pick products and set a badge for each. With no blocks, the collection below is used." },
    { "type": "collection", "id": "collection", "label": "Collection (used when no blocks)" },
    { "type": "range", "id": "limit", "label": "Products from collection", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "checkbox", "id": "show_badge", "label": "Show badge", "default": true },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour swatches", "default": true },
    { "type": "checkbox", "id": "show_quick", "label": "Show Quick add button", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "ink", "label": "Text", "default": "#1d1a18" },
    { "type": "color", "id": "muted", "label": "Muted text", "default": "#766f68" },
    { "type": "color", "id": "gold", "label": "Eyebrow", "default": "#b99159" },
    { "type": "color", "id": "btn_bg", "label": "Quick add background", "default": "#f6f1ea" },
    { "type": "color", "id": "bg", "label": "Section background", "default": "#ffffff" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 85 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 5, "unit": "px", "default": 85 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Badge (New, Limited, Bestseller…)" }
      ]
    }
  ],
  "presets": [
    { "name": "Sabha Signatures", "blocks": [{ "type": "product", "settings": { "badge": "Essential" } }, { "type": "product", "settings": { "badge": "Signature" } }, { "type": "product", "settings": { "badge": "New" } }, { "type": "product", "settings": { "badge": "Occasion" } }] }
  ]
}
{% endschema %}
