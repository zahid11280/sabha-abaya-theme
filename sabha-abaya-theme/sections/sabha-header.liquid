      data-foot
    ></div>

  </aside>

</div>


<script>

(function(){

  var sid = {{ sid | json }};

  var wrap = document.getElementById(sid + '-w');
  var root = document.getElementById(sid);

  var M = document.getElementById(sid + '-m');
  var D = document.getElementById(sid + '-c');
  var SP = document.getElementById(sid + '-s');

  if(!wrap || !root){
    return;
  }


  var S = {{ section.settings | json }};

  var fmt = {{ shop.money_format | json }};

  var FREE =
    (parseFloat(S.free_ship_threshold) || 0) * 100;


  /* =====================================================
     HELPERS
  ===================================================== */

  function money(c){

    if(
      window.Shopify &&
      typeof Shopify.formatMoney === 'function'
    ){
      return Shopify.formatMoney(c,fmt);
    }

    return '$' + (c / 100).toFixed(2);

  }


  function esc(s){

    return String(s == null ? '' : s).replace(
      /[&<>"']/g,
      function(c){

        return {
          '&':'&amp;',
          '<':'&lt;',
          '>':'&gt;',
          '"':'&quot;',
          "'":'&#39;'
        }[c];

      }
    );

  }


  /* =====================================================
     STABLE HEADER SCROLL
  ===================================================== */

  var compact = false;

  var ticking = false;

  var COLLAPSE_AT = 80;

  var EXPAND_AT = 5;


  function applyHeaderState(){

    var y =
      window.pageYOffset ||
      document.documentElement.scrollTop ||
      0;


    if(!compact && y > COLLAPSE_AT){

      compact = true;

    }
    else if(compact && y <= EXPAND_AT){

      compact = false;

    }


    wrap.classList.toggle(
      'is-scrolled',
      compact
    );


    root.classList.toggle(
      'is-scrolled',
      compact
    );

  }


  function handleScroll(){

    if(ticking){
      return;
    }


    ticking = true;


    requestAnimationFrame(function(){

      applyHeaderState();

      ticking = false;

    });

  }


  var initialY =
    window.pageYOffset ||
    document.documentElement.scrollTop ||
    0;


  compact = initialY > COLLAPSE_AT;


  wrap.classList.toggle(
    'is-scrolled',
    compact
  );


  root.classList.toggle(
    'is-scrolled',
    compact
  );


  window.addEventListener(
    'scroll',
    handleScroll,
    { passive:true }
  );


  /* =====================================================
     BODY LOCK
  ===================================================== */

  var bodyLocked = false;

  var previousOverflow = '';

  var previousPadding = '';


  function lockBody(){

    if(bodyLocked){
      return;
    }


    bodyLocked = true;


    previousOverflow =
      document.body.style.overflow;


    previousPadding =
      document.body.style.paddingRight;


    var scrollbar =
      window.innerWidth -
      document.documentElement.clientWidth;


    if(scrollbar > 0){

      var current =
        parseFloat(
          getComputedStyle(document.body).paddingRight
        ) || 0;


      document.body.style.paddingRight =
        (current + scrollbar) + 'px';

    }


    document.body.style.overflow =
      'hidden';

  }


  function unlockBody(){

    if(!bodyLocked){
      return;
    }


    bodyLocked = false;


    document.body.style.overflow =
      previousOverflow;


    document.body.style.paddingRight =
      previousPadding;

  }


  /* =====================================================
     MENU
  ===================================================== */

  function menu(open){

    if(!M){
      return;
    }


    M.classList.toggle(
      'open',
      open
    );


    M.setAttribute(
      'aria-hidden',
      String(!open)
    );


    if(open){

      if(
        D &&
        D.classList.contains('open')
      ){
        D.classList.remove('open');
        D.setAttribute('aria-hidden','true');
      }


      lockBody();

    }
    else if(
      !D ||
      !D.classList.contains('open')
    ){

      unlockBody();

    }

  }


  var menuButton =
    root.querySelector('[data-open-menu]');


  if(menuButton){

    menuButton.addEventListener(
      'click',
      function(){

        menu(true);

      }
    );

  }


  if(M){

    M.querySelectorAll('[data-close-menu]')
      .forEach(function(button){

        button.addEventListener(
          'click',
          function(){

            menu(false);

          }
        );

      });


    M.querySelectorAll('a')
      .forEach(function(a){

        a.addEventListener(
          'click',
          function(){

            menu(false);

          }
        );

      });

  }


  /* =====================================================
     SEARCH
  ===================================================== */

  var sBtn =
    root.querySelector('[data-open-search]');


  function search(open){

    if(!SP){
      return;
    }


    SP.classList.toggle(
      'open',
      open
    );


    if(sBtn){

      sBtn.setAttribute(
        'aria-expanded',
        String(open)
      );

    }


    if(open){

      setTimeout(function(){

        var input =
          SP.querySelector('input[name=q]');


        if(input){
          input.focus();
        }

      },150);

    }

  }


  if(sBtn && SP){

    sBtn.addEventListener(
      'click',
      function(){

        search(
          !SP.classList.contains('open')
        );

      }
    );


    var inp =
      SP.querySelector('input[name=q]');


    var res =
      SP.querySelector('[data-sres]');


    var searchTimer;


    if(inp && res){

      inp.addEventListener(
        'input',
        function(){

          clearTimeout(searchTimer);


          var q =
            inp.value.trim();


          if(q.length < 2){

            res.innerHTML = '';

            return;

          }


          searchTimer =
            setTimeout(function(){

              fetch(
                '/search/suggest.json?q=' +
                encodeURIComponent(q) +
                '&resources[type]=product&resources[limit]=4'
              )

              .then(function(r){

                return r.json();

              })

              .then(function(data){

                var products =
                  (
                    data.resources &&
                    data.resources.results &&
                    data.resources.results.products
                  ) || [];


                if(!products.length){

                  res.innerHTML =
                    '<p class="sb-snone">' +
                    'No pieces found for “' +
                    esc(q) +
                    '”. Try a different word.' +
                    '</p>';

                  return;

                }


                res.innerHTML =
                  '<div class="sb-sres">' +

                  products.map(function(product){

                    var image =
                      (
                        product.featured_image &&
                        product.featured_image.url
                      )
                      ?
                      '<img src="' +
                      product.featured_image.url +
                      '" alt="" loading="lazy">'
                      :
                      '';


                    var price = '';


                    if(product.price){

                      price =
                        money(
                          Math.round(
                            parseFloat(product.price) * 100
                          )
                        );

                    }


                    return (
                      '<a href="' +
                      product.url +
                      '">' +

                      '<div class="im">' +
                      image +
                      '</div>' +

                      esc(product.title) +

                      '<span>' +
                      esc(price) +
                      '</span>' +

                      '</a>'
                    );

                  }).join('') +

                  '</div>';

              })

              .catch(function(){

                res.innerHTML = '';

              });

            },250);

        }
      );

    }


    document.addEventListener(
      'click',
      function(e){

        if(
          SP.classList.contains('open') &&
          !e.target.closest('.sb-search') &&
          !e.target.closest('[data-open-search]')
        ){

          search(false);

        }

      }
    );

  }


  /* =====================================================
     CART COUNT
  ===================================================== */

  var lastCount = null;


  function count(n){

    document
      .querySelectorAll('#' + sid + ' [data-count]')
      .forEach(function(el){

        el.textContent = n;


        if(
          lastCount !== null &&
          lastCount !== n
        ){

          el.classList.add('pop');


          setTimeout(function(){

            el.classList.remove('pop');

          },300);

        }

      });


    lastCount = n;


    if(window.sbUpdateCount){

      window.sbUpdateCount(n);

    }

  }


  /* =====================================================
     SHIPPING PROGRESS
  ===================================================== */

  function ship(cart){

    if(!D){
      return;
    }


    var el =
      D.querySelector('[data-ship]');


    if(!el){
      return;
    }


    if(
      !FREE ||
      !cart.items.length
    ){

      el.hidden = true;

      return;

    }


    el.hidden = false;


    var left =
      FREE - cart.total_price;


    var percentage =
      Math.min(
        100,
        Math.round(
          cart.total_price / FREE * 100
        )
      );


    if(left > 0){

      el.innerHTML =
        '<p>' +
        esc(S.ship_more_text) +
        ' <b>' +
        money(left) +
        '</b> ' +
        esc(S.ship_more_text_2) +
        '</p>' +

        '<div class="sb-bar">' +
        '<i style="width:' +
        percentage +
        '%"></i>' +
        '</div>';

    }
    else{

      el.innerHTML =
        '<p>' +
        esc(S.ship_done_text) +
        '</p>' +

        '<div class="sb-bar">' +
        '<i style="width:100%"></i>' +
        '</div>';

    }

  }


  /* =====================================================
     CART RENDER
  ===================================================== */

  function render(cart){

    if(!D){
      return;
    }


    count(cart.item_count);

    ship(cart);


    var itemsBox =
      D.querySelector('[data-items]');


    var footer =
      D.querySelector('[data-foot]');


    if(!itemsBox || !footer){
      return;
    }


    /* EMPTY CART */

    if(!cart.items.length){

      itemsBox.innerHTML =

        '<div class="sb-dempty">' +

          '<div class="sb-dempty-icon">' +

            '<svg viewBox="0 0 24 24" aria-hidden="true">' +
              '<path d="M6 8h12l-1 11H7L6 8Z"/>' +
              '<path d="M9 8V6a3 3 0 0 1 6 0v2"/>' +
            '</svg>' +

          '</div>' +

          '<h2>' +
            esc(S.empty_title) +
          '</h2>' +

          '<p>' +
            esc(S.empty_text) +
          '</p>' +

        '</div>';


      footer.innerHTML =

        '<a class="sb-btn" href="' +
        esc(
          S.empty_link ||
          '/collections/all'
        ) +
        '">' +

          esc(S.empty_button) +

        '</a>';


      return;

    }


    /* CART ITEMS */

    itemsBox.innerHTML =
      cart.items.map(function(item,index){

        var image = '';


        if(
          item.featured_image &&
          item.featured_image.url
        ){

          var separator =
            item.featured_image.url.indexOf('?') > -1
            ? '&'
            : '?';


          image =
            '<img src="' +
            item.featured_image.url +
            separator +
            'width=200" alt="' +
            esc(item.product_title) +
            '">';

        }


        var variant = '';


        if(
          item.variant_title &&
          item.variant_title !== 'Default Title'
        ){

          variant =
            item.variant_title
              .split(' / ')
              .join(' · ');

        }


        var line =
          index + 1;


        return (

          '<div class="sb-cl">' +

            '<a class="sb-th" href="' +
            item.url +
            '">' +
              image +
            '</a>' +


            '<div class="sb-cl-info">' +

              '<h4>' +
                '<a href="' +
                item.url +
                '">' +
                  esc(item.product_title) +
                '</a>' +
              '</h4>' +

              (
                variant
                ?
                '<small>' +
                  esc(variant) +
                '</small>'
                :
                ''
              ) +

              '<div class="sb-line-actions">' +

                '<span class="sb-qty">' +

                  '<button ' +
                    'type="button" ' +
                    'data-q="' +
                    line +
                    '" ' +
                    'data-n="' +
                    Math.max(0,item.quantity - 1) +
                    '" ' +
                    'aria-label="Decrease quantity">' +
                      '−' +
                  '</button>' +

                  '<span>' +
                    item.quantity +
                  '</span>' +

                  '<button ' +
                    'type="button" ' +
                    'data-q="' +
                    line +
                    '" ' +
                    'data-n="' +
                    (item.quantity + 1) +
                    '" ' +
                    'aria-label="Increase quantity">' +
                      '+' +
                  '</button>' +

                '</span>' +


                '<button ' +
                  'class="sb-rm" ' +
                  'type="button" ' +
                  'data-q="' +
                  line +
                  '" ' +
                  'data-n="0" ' +
                  'aria-label="Remove ' +
                  esc(item.product_title) +
                  '">' +

                  '<svg viewBox="0 0 24 24" aria-hidden="true">' +
                    '<path d="M4 7h16"/>' +
                    '<path d="M9 7V4h6v3"/>' +
                    '<path d="M7 7l1 13h8l1-13"/>' +
                    '<path d="M10 11v5M14 11v5"/>' +
                  '</svg>' +

                  esc(S.remove_text) +

                '</button>' +

              '</div>' +

            '</div>' +


            '<div class="sb-cl-price">' +
              money(item.final_line_price) +
            '</div>' +

          '</div>'

        );

      }).join('');


    /* CART FOOTER */

    footer.innerHTML =

      '<label>' +

        esc(S.promo_label) +

        '<input ' +
          'id="' +
          sid +
          '-promo" ' +
          'placeholder="' +
          esc(S.promo_placeholder) +
          '">' +

      '</label>' +


      '<div class="sb-total">' +

        '<span>' +
          esc(S.subtotal_label) +
        '</span>' +

        '<b>' +
          money(cart.total_price) +
        '</b>' +

      '</div>' +


      '<button ' +
        'class="sb-btn" ' +
        'type="button" ' +
        'data-checkout>' +

        esc(S.checkout_text) +

      '</button>' +


      '<small>' +
        esc(S.cart_note) +
      '</small>';

  }


  /* =====================================================
     REFRESH CART
  ===================================================== */

  function refresh(){

    return fetch(
      '/cart.js',
      {
        credentials:'same-origin'
      }
    )

    .then(function(response){

      return response.json();

    })

    .then(function(cart){

      render(cart);

      return cart;

    });

  }


  /* =====================================================
     OPEN / CLOSE CART
  ===================================================== */

  function openCart(){

    if(!D){
      return;
    }


    search(false);


    if(
      M &&
      M.classList.contains('open')
    ){

      M.classList.remove('open');

      M.setAttribute(
        'aria-hidden',
        'true'
      );

    }


    D.classList.add('open');


    D.setAttribute(
      'aria-hidden',
      'false'
    );


    lockBody();


    refresh();

  }


  function closeCart(){

    if(!D){
      return;
    }


    D.classList.remove('open');


    D.setAttribute(
      'aria-hidden',
      'true'
    );


    if(
      !M ||
      !M.classList.contains('open')
    ){

      unlockBody();

    }

  }


  var cartButton =
    root.querySelector('[data-open-cart]');


  if(cartButton){

    cartButton.addEventListener(
      'click',
      openCart
    );

  }


  /* =====================================================
     CART ACTIONS
  ===================================================== */

  if(D){

    D.addEventListener(
      'click',
      function(e){

        /* Close */

        if(
          e.target.closest('[data-close-cart]')
        ){

          closeCart();

          return;

        }


        /* Quantity / Remove */

        var quantityButton =
          e.target.closest('[data-q]');


        if(quantityButton){

          var line =
            Number(
              quantityButton.dataset.q
            );


          var quantity =
            Math.max(
              0,
              Number(
                quantityButton.dataset.n
              )
            );


          quantityButton.disabled = true;


          fetch(
            '/cart/change.js',
            {
              method:'POST',

              credentials:'same-origin',

              headers:{
                'Content-Type':'application/json'
              },

              body:JSON.stringify({
                line:line,
                quantity:quantity
              })
            }
          )

          .then(function(response){

            return response.json();

          })

          .then(function(cart){

            render(cart);

          })

          .catch(function(){

            quantityButton.disabled = false;

          });


          return;

        }


        /* Checkout */

        if(
          e.target.closest('[data-checkout]')
        ){

          var promo =
            document.getElementById(
              sid + '-promo'
            );


          var code =
            promo
            ? promo.value.trim()
            : '';


          if(code){

            window.location.href =
              '/checkout?discount=' +
              encodeURIComponent(code);

          }
          else{

            window.location.href =
              '/checkout';

          }

        }

      }
    );

  }


  /* =====================================================
     ESC
  ===================================================== */

  document.addEventListener(
    'keydown',
    function(e){

      if(e.key !== 'Escape'){
        return;
      }


      search(false);


      if(
        D &&
        D.classList.contains('open')
      ){

        closeCart();

      }


      if(
        M &&
        M.classList.contains('open')
      ){

        menu(false);

      }

    }
  );


  /* =====================================================
     CUSTOM ADD TO CART EVENT
  ===================================================== */

  document.addEventListener(
    'sabha:cart:add',
    function(){

      openCart();

    }
  );


  /* Public helper */

  window.sabhaCart = {
    open:openCart,
    close:closeCart,
    refresh:refresh
  };


  /* Initial cart sync */

  refresh();

})();

</script>


