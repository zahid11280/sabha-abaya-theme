{%- comment -%} params: product, badge, block_attrs, show_badge, show_swatches, show_quick {%- endcomment -%}
{%- assign hexmap = 'Black:#171717|Mocha:#8a6f5a|Navy:#273746|Charcoal:#494544|Taupe:#a88f7b|Mushroom:#9a887a|Olive:#62654b|Cocoa:#765747|Rose:#b78f92|Stone:#9a9288|Plum:#654957|Sand:#c0a986|Brown:#624b3b|Forest:#405a4b|Oyster:#d4c9b9|Midnight:#1f2333|Burgundy:#692f3a|Oat:#cbbd9f|White:#eee9df|Sage:#8f9a83|Espresso:#4b352c' | split: '|' -%}
{%- assign badge_text = badge -%}
{%- if badge_text == blank -%}{%- assign badge_text = product.metafields.custom.badge.value -%}{%- endif -%}
{%- if badge_text == blank -%}
  {%- for t in product.tags -%}{%- if t contains 'badge:' -%}{%- assign badge_text = t | remove: 'badge:' -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- assign colour_opt = nil -%}
{%- assign cidx = 0 -%}
{%- for opt in product.options_with_values -%}
  {%- assign n = opt.name | downcase -%}
  {%- if n == 'colour' or n == 'color' -%}{%- assign colour_opt = opt -%}{%- assign cidx = opt.position | minus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- assign sizes_str = '' -%}
{%- for opt in product.options_with_values -%}{%- assign n2 = opt.name | downcase -%}{%- if n2 == 'size' -%}{%- assign sizes_str = opt.values | join: ' ' -%}{%- endif -%}{%- endfor -%}
{%- assign colors_str = colour_opt.values | join: ' ' | downcase -%}
{%- capture vjson -%}[{%- for v in product.variants -%}{"id":{{ v.id }},"o":{{ v.options | json }},"a":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
<article class="sb-card" {{ block_attrs }} data-name="{{ product.title | downcase | escape }}" data-price="{{ product.price | divided_by: 100.0 }}" data-colors="{{ colors_str | escape }}" data-sizes="{{ sizes_str | escape }}" data-variants="{{ vjson | escape }}" data-ci="{{ cidx }}" data-color="{{ colour_opt.values.first | escape }}">
  <a href="{{ product.url }}">
    <div class="sb-img">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="800" height="1067">
      {%- endif -%}
      {%- if show_badge and badge_text != blank -%}<span class="sb-pill">{{ badge_text }}</span>{%- endif -%}
    </div>
  </a>
  <h3>{{ product.title }}</h3>
  <div class="sb-meta">
    <span>{{ product.price | money_with_currency | replace: ' USD', '' }}</span>
    {%- if colour_opt -%}<span>{{ colour_opt.values.size }} colours</span>{%- endif -%}
  </div>
  {%- if colour_opt and show_swatches -%}
    <div class="sb-swatches" aria-label="Available colours">
      {%- for val in colour_opt.values -%}
        {%- assign hex = val | handleize -%}
        {%- for m in hexmap -%}
          {%- assign kv = m | split: ':' -%}
          {%- if kv[0] == val -%}{%- assign hex = kv[1] -%}{%- endif -%}
        {%- endfor -%}
        {%- assign vimg = nil -%}
        {%- for v in product.variants -%}
          {%- if v.options[cidx] == val and v.featured_image and vimg == nil -%}{%- assign vimg = v.featured_image | image_url: width: 800 -%}{%- endif -%}
        {%- endfor -%}
        <button type="button" class="{% if forloop.first %}active{% endif %}" style="--sw:{{ hex }}" aria-label="Show {{ val | escape }}" title="{{ val | escape }}" {% if vimg %}data-img="{{ vimg }}"{% endif %}></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if show_quick -%}<button type="button" class="sb-quick">Quick add</button>{%- endif -%}
</article>
